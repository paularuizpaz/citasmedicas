<%
const body = `
  <section class="auth-shell">
    <div class="auth-card">
      <div class="auth-header">
        <span class="eyebrow">Acceso clínico</span>
        <h2>Iniciar sesión</h2>
      </div>

      ${error ? `<div class="alert error">${error}</div>` : ''}

      <form method="POST" action="/login">
        <input type="hidden" name="_csrf" value="${csrfToken}">
        <div class="form-grid">
          <div>
            <label for="ci">Cédula de identidad</label>
            <input id="ci" name="ci" required placeholder="Ej. 12345678" />
          </div>
          <div>
            <label for="password">Contraseña</label>
            <input id="password" name="password" type="password" required placeholder="********" />
          </div>
        </div>

        <div class="auth-actions">
          <button type="submit" class="btn">Entrar</button>
          <a href="/register" class="button-link">Crear cuenta</a>
        </div>
      </form>
    </div>

    <aside class="benefit-panel">
      <div class="mini-stat">
        <span>Atención premium</span>
        <strong>24/7</strong>
      </div>
      <h3>Tu salud, en buenas manos</h3>
      <ul class="benefit-list">
        <li>Reservas rápidas y seguras</li>
        <li>Doctores especialistas disponibles</li>
        <li>Recordatorios automáticos por email</li>
      </ul>
    </aside>
  </section>
`;
%>
<%- include('layout', { title, body }) %>
