<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %> | Citas Médicas</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
      :root {
        --bg: #f4f8ff;
        --panel: #ffffff;
        --primary: #1f6feb;
        --primary-dark: #174da8;
        --secondary: #dfeeff;
        --text: #1b2a41;
        --muted: #6b7a90;
        --success: #1bbf7a;
        --danger: #e85d75;
        --border: #dfe7f6;
      }

      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: 'Inter', sans-serif;
        background: linear-gradient(180deg, #edf5ff 0%, #f8fbff 100%);
        color: var(--text);
      }
      a { color: inherit; text-decoration: none; }
      .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 28px 20px 60px;
      }
      .topbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: rgba(255,255,255,0.8);
        backdrop-filter: blur(10px);
        border: 1px solid var(--border);
        border-radius: 18px;
        padding: 16px 24px;
        margin-bottom: 28px;
        box-shadow: 0 10px 25px rgba(31,111,235,0.08);
      }
      .brand {
        font-size: 1.3rem;
        font-weight: 800;
        color: var(--primary-dark);
      }
      .nav {
        display: flex;
        gap: 16px;
        align-items: center;
      }
      .nav a {
        color: var(--text);
        font-weight: 600;
      }
      .btn {
        display: inline-block;
        border: none;
        border-radius: 12px;
        padding: 12px 18px;
        background: var(--primary);
        color: white;
        font-weight: 700;
        cursor: pointer;
        transition: 0.2s ease;
      }
      .btn:hover { background: var(--primary-dark); }
      .btn.secondary {
        background: #eef5ff;
        color: var(--primary-dark);
      }
      .btn.danger {
        background: var(--danger);
      }
      .card {
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(38, 64, 120, 0.08);
      }
      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 20px;
      }
      .form-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 16px;
      }
      label {
        display: block;
        font-weight: 600;
        margin-bottom: 8px;
        color: var(--muted);
      }
      input, select, textarea {
        width: 100%;
        padding: 13px 14px;
        border: 1px solid var(--border);
        background: #f9fbff;
        border-radius: 12px;
        font: inherit;
        color: var(--text);
      }
      textarea { min-height: 110px; resize: vertical; }
      .panel {
        padding: 24px;
      }
      .hero {
        padding: 30px;
        margin-bottom: 26px;
        background: linear-gradient(135deg, #1f6feb 0%, #7cb3ff 100%);
        color: white;
      }
      .hero h1 {
        margin: 0 0 12px 0;
        font-size: clamp(2rem, 3vw, 3rem);
      }
      .hero p {
        margin: 0;
        font-size: 1.05rem;
        opacity: 0.95;
      }
      .alert {
        padding: 14px 16px;
        border-radius: 12px;
        margin-bottom: 24px;
        font-weight: 600;
      }
      .alert.error {
        background: #fff0f2;
        border: 1px solid #ffc1ce;
        color: #b3263a;
      }
      .alert.success {
        background: #edfdf5;
        border: 1px solid #abf0c8;
        color: #0d7f53;
      }
      .list {
        padding: 0;
        list-style: none;
        display: grid;
        gap: 12px;
      }
      .list li {
        background: #f8fbff;
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 16px;
      }
      .slot-list {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 12px;
      }
      .slot {
        background: #eaf3ff;
        border: 1px solid #cfe1ff;
        color: var(--primary-dark);
        padding: 8px 10px;
        border-radius: 10px;
        font-weight: 700;
      }
      .muted { color: var(--muted); }
      table {
        width: 100%;
        border-collapse: collapse;
      }
      th, td {
        text-align: left;
        padding: 12px 10px;
        border-bottom: 1px solid var(--border);
      }
      th { color: var(--muted); font-weight: 700; }
      @media (max-width: 700px) {
        .topbar { flex-direction: column; gap: 16px; }
        .nav { flex-wrap: wrap; justify-content: center; }
      }
    </style>
  </head>
  <body>
    <div class="container">
      <header class="topbar">
        <div class="brand">DentalCare+</div>
        <nav class="nav">
          <% if (typeof user !== 'undefined' && user) { %>
            <a href="/dashboard">Dashboard</a>
            <a href="/appointments/new">Nueva cita</a>
            <% if (user.role === 'patient') { %>
              <a href="/doctor/register">Registrar doctor</a>
            <% } %>
            <a href="/logout" class="btn secondary">Cerrar sesión</a>
          <% } else { %>
            <a href="/login">Iniciar sesión</a>
            <a href="/register">Registrarse</a>
          <% } %>
        </nav>
      </header>

      <%- body %>
    </div>
  </body>
</html>
